PORT=3002

# Postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=emerge
DB_PASSWORD=emerge
DB_DATABASE=emerge_academy

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS: URL del frontend
FRONTEND_ORIGIN=http://localhost:3000

# Correos que deben tener rol "admin" (pueden programar sesiones en vivo), separados por
# coma. Se asigna automáticamente al iniciar sesión o registrarse; no hay panel para
# asignarlo desde la interfaz.
ADMIN_EMAILS=jou@example.com
