PORT=3002

# Postgres
# En Railway basta con DATABASE_URL (referencia a ${{Postgres.DATABASE_URL}}); si existe,
# tiene prioridad sobre las variables DB_*. DB_SSL=true solo si tu proveedor exige SSL.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
# DB_SSL=false
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=emerge
DB_PASSWORD=emerge
DB_DATABASE=emerge_academy

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS: URL(s) del frontend, separadas por coma
FRONTEND_ORIGIN=http://localhost:3000

# Correos que deben tener rol "admin" (pueden programar sesiones en vivo), separados por
# coma. Se asigna automáticamente al iniciar sesión o registrarse; no hay panel para
# asignarlo desde la interfaz.
ADMIN_EMAILS=jou@example.com
